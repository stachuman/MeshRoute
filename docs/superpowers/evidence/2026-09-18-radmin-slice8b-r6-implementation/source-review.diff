+                                      Print& usb, Print* ble, bool ble_connected,
+                                      RemoteClientBindLookup lookup, void* node) {
+    RemoteClientDelivery delivery(usb, ble, ble_connected);
+    remote_client_observe_push(state, pu, delivery, lookup, node);
+}
