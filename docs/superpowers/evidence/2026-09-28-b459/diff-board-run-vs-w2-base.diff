 if ! build V3_DEFS "$CANVAS/board_ui.cpp" "$OUT/probe_v3"; then
-  echo "V3 PROBE BUILD FAILED — see above"; exit 1
+  echo "V3 PROBE BUILD FAILED — see above"; rc=1; board_end "$MODE"; exit 1
