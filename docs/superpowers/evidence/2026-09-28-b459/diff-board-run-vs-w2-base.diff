+# =====================================================================================================================
+# ★★★★ [[B459]] — EVERY DECLARED IDENTITY GETS EXACTLY ONE TERMINAL OBSERVATION, AND THE RUN PROVES IT
+# =====================================================================================================================
+# ⛔ THE DEFECT THIS CLOSES, MEASURED (B459 pre-check Q2, 2026-09-28): every layer below only COUNTED what happened to
+#   run, and nothing compared the counts with what should have run. A false or undefined guard before W1, an early
+#   return, a negctl loop shortened by one control, or one deleted canvas CHK each still exited 0.
+# ★ THE CONTRACT (brief §2.2):
+#   1. the EXPECTED set is the checked-in manifest `expected.tsv` — every identity, each with its ONE accepted outcome.
+#      Adding, retiring or renaming a check is a manifest edit, visible in the diff;
+#   2. before anything compiles, the STATIC CENSUS (`accounting.py`) lists what the SOURCE declares, and the shared
+#      comparator must find that list equal to the manifest (fail-closed: an unrecognised call shape fails too) — so a
+#      call removed from the source while its manifest line stays is caught before any build;
+#   3. every executed identity records ONE terminal observation through ONE recorder (`rec`): the shell layers
+#      directly; the two positive canvas runs and `negctl.py` through a record file this runner names and imports.
+#      ⛔ Only the two POSITIVE canvas runs are ever handed a canvas record file, so a mutant can never satisfy one;
+#   4. the run ends in ONE finalization (`board_final`) for all three modes: the manifest against the observations and
+#      the guard ledger, through the SHARED comparator (`tools/probe_accounting.sh`). A missing, duplicate or unknown
+#      identity, a wrong outcome or any guard failure fails the run;
+#   5. harness errors are recorded, never credited: a failed sed is a rejected control, a predicate exit other than 0
+#      or 1 is an error on the live AND the mutant path, and a guard that stops a call leaves its identity MISSING.
+# ⛔ THE HONEST LIMIT: a check removed TOGETHER with its manifest line is invisible to the census and at runtime —
+#   nothing can infer the deleted intent. The manifest diff is what makes such a removal visible, in review.
+# ⓘ THE OUTCOME CONTRACTS ARE PRESERVED, NOT TIGHTENED (brief §2.2.3): e.g. a trait mutant that CRASHES still counts
+#   as `red`, exactly as before — that weakness is [[B473]], deliberately not fixed here.
+PA_LIB="$ROOT/tools/probe_accounting.sh"
+if [ ! -f "$PA_LIB" ]; then
+  echo "FATAL: the shared accounting library is missing: $PA_LIB — nothing can be accounted, so nothing runs"; exit 2
+fi
+. "$PA_LIB"
+MANIFEST="$HERE/expected.tsv"
+NO_NEG_BANNER="PROBE-ONLY — NOT A GATE (--no-neg: canvas mutation controls skipped)"
+MODE=gate; [ "${1:-}" = "--no-neg" ] && MODE=no-neg
+OBS="$OUT/observations.tsv"; GUARDS="$OUT/guards.txt"
+: > "$OBS"; : > "$GUARDS"
+unset MR_BOARD_UI_RECORDS MR_BOARD_UI_NEGCTL_RECORDS   # ⛔ a record file is named per positive run, never inherited
+rec()   { pa_record "$OBS" "$@"; }     # rec <id> <outcome> [<detail>] — THE one terminal-observation path
+guard() { pa_guard "$GUARDS" "$1"; }   # guard <what failed> — a guard is not an identity, so it has its own ledger
+
+import_records() {   # import_records <namespace> <record file> — a child's `id<TAB>outcome[<TAB>kind]` lines, checked
+  local ns=$1 file=$2 line n=0
+  if [ ! -f "$file" ]; then guard "$ns: the child wrote no record file"; return; fi
+  if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then guard "$ns: the record file is truncated (no final newline)"; fi
+  while IFS= read -r line; do
+    n=$((n+1))
+    if [[ "$line" =~ ^([A-Za-z][A-Za-z0-9-]*(/[0-9]+)?)$'\t'([a-z_]+)($'\t'([a-z_]+))?$ ]]; then
+      if [ -n "${BASH_REMATCH[5]}" ]; then rec "$ns/${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[5]}"
+      else                                 rec "$ns/${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}"
+      fi
+    else
+      guard "$ns: malformed record $n: ${line:0:80}"
+    fi
+  done < "$file"
+}
+
+# THE OUTCOME OF EACH LAYER, AS ONE FUNCTION EACH — the layer below calls it, and the selftest drives it directly.
+# ⚠ Each reproduces its layer's contract EXACTLY as it was (brief §2.2.3); only the harness errors are new words.
+trait_outcome() {   # <anchor hits> <build exit> <probe exit> -> red | anchor_miss | no_compile | stayed_green
+  if   [ "$1" -ne 1 ]; then echo anchor_miss
+  elif [ "$2" -ne 0 ]; then echo no_compile
+  elif [ "$3" -eq 0 ]; then echo stayed_green
+  else                      echo red          # ⓘ ANY nonzero probe exit, a crash included — [[B473]], unchanged
+  fi
+}
+missing_outcome() {   # <removal hits> <build exit> <named #error seen: 1|0> -> named_compile_error | anchor_miss | compiled | unrelated_compile_error
+  if   [ "$1" -ne 1 ]; then echo anchor_miss
+  elif [ "$2" -eq 0 ]; then echo compiled
+  elif [ "$3" -ne 1 ]; then echo unrelated_compile_error
+  else                      echo named_compile_error
+  fi
+}
+wiring_outcome() {   # <live predicate exit> -> pass | fail | harness_error
+  case $1 in 0) echo pass ;; 1) echo fail ;; *) echo harness_error ;; esac
+}
+wiring_control_outcome() {   # <sed exit> <copy differs: 1|0> <mutant predicate exit> -> red | sed_failed | vacuous | still_true | harness_error
+  if   [ "$1" -ne 0 ]; then echo sed_failed
+  elif [ "$2" -ne 1 ]; then echo vacuous
+  else case $3 in 1) echo red ;; 0) echo still_true ;; *) echo harness_error ;; esac
+  fi
+}
+
+board_final() {   # board_final <gate|no-neg> <expected set> — THE ONE finalization, for all three modes
+  local mode=$1 expected="$OUT/expected_run.tsv"
+  if [ "$mode" = no-neg ]; then grep -v -e '^#' -e '^$' -e '^negctl/' "$2" > "$expected"
+  else                          grep -v -e '^#' -e '^$' "$2" > "$expected"
+  fi
+  echo
+  echo "== [[B459]] completion accounting (every expected identity against the recorded observations) =="
+  pa_compare "$expected" "$OBS" "$GUARDS" '[[B459]]' 'probe identity' 'its recorder' 'identities accounted' || rc=1
+  awk -F'\t' '   # per-namespace counts — diagnostic only; the verdict above belongs to the comparator
+    function ns(id,   p) { split(id, p, "/")
+      if (p[1] == "wiring") return (id ~ /\/control\//) ? "wiring/control" : "wiring"
+      if (p[1] == "canvas" || p[1] == "negctl") return p[1] "/" p[2]
+      return p[1] }
+    FILENAME == ARGV[1] { k = ns($1); if (!(k in d) && !(k in x)) o[++m] = k; d[k]++; next }
+    { k = ns($1); if (!(k in d) && !(k in x)) o[++m] = k; x[k]++ }
+    END { for (i = 1; i <= m; i++) printf "  %-15s %4d expected, %4d observed\n", o[i], d[o[i]] + 0, x[o[i]] + 0 }' \
+    "$expected" "$OBS"
+  awk -F'\t' '   # brief §2.2.4 — every live wiring predicate must exit 0 and every mutant evaluation 1
+    $1 ~ /^wiring\// && $3 ~ /^pred_exit=/ { e = substr($3, 11); if ($1 ~ /\/control\//) m[e]++; else l[e]++ }
+    $1 ~ /^negctl\// && NF >= 3 { split($1, p, "/"); kinds[p[2] " " $3]++ }
+    END { printf "wiring predicate exits: live"; for (e in l) printf " %d x exit %s", l[e], e
+          printf "; mutant"; for (e in m) printf " %d x exit %s", m[e], e; printf "\n"
+          for (k in kinds) printf "negctl %s: %d\n", k, kinds[k] }' "$OBS"
+  if [ "$mode" = no-neg ]; then
+    echo "negctl: $(grep -c '^negctl/' "$2") identities SKIPPED by mode (--no-neg), and any negctl observation fails the run"
+  fi
+}
+board_end() {   # board_end <gate|no-neg> — the last line: PASS or FAIL, and the banner in --no-neg (never a PASS)
+  if [ "$1" = no-neg ]; then [ "$rc" -eq 0 ] || echo "FAIL"; echo "$NO_NEG_BANNER"
+  elif [ "$rc" -eq 0 ]; then echo "PASS"
+  else echo "FAIL"
+  fi
+}
+
+if [ "${1:-}" = "--selftest-accounting" ]; then
+  # ⓘ SYNTHETIC. <dir>/expected.tsv is the expected set and <dir>/events one `kind<TAB>args…` line per event, replayed
+  #   through THIS runner's recorder, importer, outcome functions, guards and `board_final` — nothing is compiled.
+  st_dir=${2:?--selftest-accounting needs a directory}; st_mode=gate; [ "${3:-}" = "--no-neg" ] && st_mode=no-neg
+  rc=0
+  echo "== [[B459]] SYNTHETIC accounting selftest ($st_mode) — replayed records; nothing is compiled or run =="
+  while IFS=$'\t' read -r st_k st_a st_b st_c st_d; do
+    case "$st_k" in
+      record)         if [ -n "$st_c" ]; then rec "$st_a" "$st_b" "$st_c"; else rec "$st_a" "$st_b"; fi ;;
+      guard)          guard "$st_a" ;;
+      guard_nonzero)  false && rec "$st_a" pass ;;                                              # `<guard> && call`
+      guard_127)      __b459_selftest_undefined_helper__ 2>/dev/null && rec "$st_a" pass ;;    # exit 127
+      import)         import_records "$st_a" "$st_dir/$st_b" ;;
+      trait)          rec "$st_a" "$(trait_outcome "$st_b" "$st_c" "$st_d")" ;;
+      missing)        rec "$st_a" "$(missing_outcome "$st_b" "$st_c" "$st_d")" ;;
+      wiring)         rec "$st_a" "$(wiring_outcome "$st_b")" "pred_exit=$st_b" ;;
+      wiring_control) rec "$st_a" "$(wiring_control_outcome "$st_b" "$st_c" "$st_d")" "pred_exit=$st_d" ;;
+      '')             ;;
+      *)              echo "  FAIL [[B459]] selftest: unknown event kind [$st_k]"; rc=1 ;;
+    esac
+  done < "$st_dir/events"
+  board_final "$st_mode" "$st_dir/expected.tsv"
+  board_end "$st_mode"
+  exit $rc
+fi
+
+# ★ THE STATIC DECLARATION CENSUS, before anything is compiled (brief §2.2.5). The probe is PREPROCESSED per arm with
+#   that arm's own defines (directives only, no macro expansion), so a CHK behind the other arm's `#if` is not counted.
+echo "== [[B459]] static declaration census (what the source declares, against expected.tsv) =="
+board_census() {
+  "$CXX" -std=gnu++20 -E -fdirectives-only "${V3_DEFS[@]}" \
+     -I"$HERE/fakes" -I"$CANVAS" -I"$ROOT/lib/hal" -I"$ROOT/lib/core" -I"$ROOT/src" \
+     "$HERE/probe_main.cpp" -o "$OUT/probe_v3.i" || return 1
+  "$CXX" -std=gnu++20 -E -fdirectives-only "${V4_DEFS[@]}" \
+     -I"$HERE/fakes" -I"$CANVAS" -I"$ROOT/lib/hal" -I"$ROOT/lib/core" -I"$ROOT/src" \
+     "$HERE/probe_main.cpp" -o "$OUT/probe_v4.i" || return 1
+  python3 "$HERE/accounting.py" census "$HERE/$(basename "${BASH_SOURCE[0]}")" "$OUT/probe_v3.i" "$OUT/probe_v4.i" \
+     "$HERE/negctl.py" > "$OUT/declared.tsv" || return 1
+  grep -v -e '^#' -e '^$' "$MANIFEST" > "$OUT/manifest.tsv" 2>/dev/null
+  : > "$OUT/census_guards.txt"
+  pa_compare "$OUT/manifest.tsv" "$OUT/declared.tsv" "$OUT/census_guards.txt" '[[B459]] census:' 'manifest identity' \
+             'a declaration in the source' 'declarations census'
+}
+if ! board_census; then
+  echo "  FAIL [[B459]] the source's declarations are not the manifest's — fail-closed: nothing is built or run"
+  rc=1; board_end "$MODE"; exit 1
+fi
+echo
+
